# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database & Cache
MONGO_URI=mongodb://localhost:27017/ecommerce?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Authentication (Minimum 32 characters for HMAC SHA-256)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Payment Gateways (Use Sandbox/Test keys)
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Inventory & Checkout
RESERVATION_TTL_MINUTES=15

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=5
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
